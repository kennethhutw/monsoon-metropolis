# ── 必填 ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx           # Claude API（server-only）
NEXT_PUBLIC_CONTRACT_MODE=mock          # mock | real
SESSION_SECRET=xxxx                     # 隨便一串長隨機字串即可（openssl rand -hex 32），登入 session 簽章用

# ── Demo 設定 ────────────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_NAME=Monsoon

# ── Supabase（Phase 1 用 Mock，切換後填入）───────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx       # server-only，不可用 NEXT_PUBLIC_

# ── 合約（CONTRACT_MODE=real 時才需要）──────────────────
# 從 Monsoon_contract/output/deploy_monadTestnet_*.txt 複製
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz/
NEXT_PUBLIC_COMPLIANCE_REGISTRY=0x...
NEXT_PUBLIC_INVOICE_ASSET=0x...
NEXT_PUBLIC_FINANCING_POOL=0x...
NEXT_PUBLIC_STABLECOIN=0x...

# ComplianceRegistry 的 admin 私鑰（server-only，不可加 NEXT_PUBLIC_）
# 必須是 deploy.ts 執行時被 setAdmin(..., true) 的地址
# 用途：CVI 核發/撤銷（registerCVI/revokeCVI）代表平台簽署，不代表使用者本人
ADMIN_PRIVATE_KEY=0x...

# ── Cleanverse（CONTRACT_MODE=real 時才會呼叫）──────────
# api-id/api-key 由 Cleanverse 主辦方提供，不進 git
CLEANVERSE_API_ID=APP20260614112550LIDZXM
CLEANVERSE_API_KEY=xxxx                 # server-only，AES 加解密用
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate

# scripts/launch-atoken.ts 用（一次性 bootstrap，發行 CVA 結算幣才需要）
ADMIN_WALLET_ADDRESS=0x...

# ── GoPlus Security（錢包 AML 篩查，CONTRACT_MODE=real 時才會呼叫）──
GOPLUS_API_KEY=xxxx
GOPLUS_API_SECRET=xxxx

# ── AI Provider 抽象層（case 風險評分 / 負面新聞摘要用）──────
AI_PROVIDER=anthropic                   # anthropic | openrouter
OPENROUTER_API_KEY=xxxx                 # AI_PROVIDER=openrouter 時才需要
OPENROUTER_MODEL=xxxx                   # 同上
EXA_API_KEY=xxxx                        # 負面新聞掃描（News Scan）用
CASE_AI_MODEL=default                   # default | kimi；kimi = 案件風險評分改用 Kimi K2.6（需 OPENROUTER_API_KEY）

# ── Server 端 RPC Provider 開關（/admin/health 監控用，不影響錢包連線）──
RPC_PROVIDER=default                    # default | alchemy
ALCHEMY_API_KEY=xxxx                    # server-only，不可加 NEXT_PUBLIC_；RPC_PROVIDER=alchemy 時才需要
