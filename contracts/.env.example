# ── Deployer ─────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0x...

# ── Networks ─────────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz/
BASE_RPC_URL=https://sepolia.base.org

# ── Post-deploy (fill in after `npm run deploy:monad`) ────
COMPLIANCE_REGISTRY_ADDRESS=0x_TODO
INVOICE_ASSET_ADDRESS=0x_TODO
FINANCING_POOL_ADDRESS=0x_TODO

# Bank wallet used by FinancingPool — leave unset to let the deployer stand in as the bank
BANK_WALLET_ADDRESS=0x...

# Set after `npm run setup:atoken` (launch-atoken.ts in Monsoon_App issues the real one)
MOCK_USDC_ADDRESS=0x_TODO

# ── Cleanverse (same values as Monsoon_App/.env.local) ────
CLEANVERSE_API_ID=APP...
CLEANVERSE_API_KEY=...
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate

# ── Test wallets for scripts/onboard-exporter.ts / onboard-buyer.ts ─
EXPORTER_WALLET_ADDRESS=0x...
BUYER_WALLET_ADDRESS=0x...

# ── Contract verification (optional) ──────────────────────
MONAD_EXPLORER_API_KEY=
BASESCAN_API_KEY=
